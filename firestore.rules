rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Home root ──
    match /homes/{homeId} {
      allow read, write: if request.auth != null;

      // ── Floors ──
      match /floors/{floorId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }

      // ── Devices ──
      match /devices/{deviceId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && validateDevice(request.resource.data);
      }

      // ── Usage Logs (read-only for clients; Cloud Functions write) ──
      match /usageLogs/{logId} {
        allow read: if request.auth != null;
        allow write: if false; // Only Cloud Functions can write
      }
    }
  }
}

function validateDevice(data) {
  return data.keys().hasAll(['name', 'type', 'state', 'floorId'])
    && data.type in ['OUTLET', 'MULTI_SWITCH', 'IRON', 'LIGHT', 'CAMERA']
    && data.state in ['ON', 'OFF', 'ERROR', 'DISCONNECTED'];
}
